{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ledger",
  "version": "0.1.0",
  "identifier": "com.local.ledger",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ledger",
        "width": 1080,
        "height": 720,
        "minWidth": 680,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Finance",
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
